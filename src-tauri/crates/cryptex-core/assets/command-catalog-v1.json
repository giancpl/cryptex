      "signature": "\\procedureblock[options]{name}{body}",
      "snippet": "\\procedureblock{${1:Name}}{\n  ${2:x \\sample S} \\\\\n  \\pcreturn ${3:x}\n}\n$0",
      "examples": [
        {
          "title": "Basic use",
          "latex": "\\procedureblock{Sample}{x \\sample S \\\\ \\pcreturn x}",
