    {
      "id": "latex.section",
      "command": "\\section",
      "displayName": "Section",
      "summary": "Starts a numbered document section.",
      "concepts": ["section", "document structure"],
      "synonyms": ["heading"],
      "requirements": [],
      "signature": "\\section{title}",
      "snippet": "\\section{${1:Title}}\n$0",
      "examples": [
        {
          "title": "Basic use",
          "latex": "\\section{Introduction}",
          "explanation": "Starts a numbered document section."
        }
      ],
      "documentationUrl": "https://latexref.xyz/",
      "contexts": ["text"],
      "provenance": {
        "sourceTitle": "LaTeX Project core documentation",
        "sourceUrl": "https://www.latex-project.org/help/documentation/",
        "sourceVersion": "LaTeX2e 2026-06-01"
      }
    },
