      "signature": "x \\sample S",
      "snippet": "${1:x} \\sample ${2:S}$0",
      "examples": [
        {
          "title": "Basic use",
          "latex": "x \\sample \\bin",
          "explanation": "Produces the random-sampling assignment symbol."
