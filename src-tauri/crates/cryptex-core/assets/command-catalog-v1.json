    {
      "id": "cryptocode.pseudocode",
      "command": "\\pseudocode",
      "displayName": "Pseudocode",
      "summary": "Typesets an inline pseudocode block.",
      "concepts": ["pseudocode", "algorithm"],
      "synonyms": ["algorithm block"],
      "requirements": [
        {
          "package": "cryptocode",
          "versionRequirement": "=0.44"
        }
      ],
      "signature": "\\pseudocode[options]{body}",
      "snippet": "\\pseudocode{\n  ${1:x \\sample S} \\\\\n  \\pcreturn ${2:x}\n}\n$0",
      "examples": [
        {
          "title": "Basic use",
          "latex": "\\pseudocode{x \\sample S \\\\ \\pcreturn x}",
          "explanation": "Typesets an inline pseudocode block."
        }
      ],
      "documentationUrl": "https://ctan.org/pkg/cryptocode",
      "contexts": ["text"],
      "provenance": {
        "sourceTitle": "Cryptocode: Typesetting Cryptography",
        "sourceUrl": "https://mirrors.ctan.org/macros/latex/contrib/cryptocode/cryptocode.pdf",
        "sourceVersion": "0.44"
      }
    },
    {
      "id": "cryptocode.procedureblock",
